# Discogs personal access token and username (https://www.discogs.com/settings/developers)
DISCOGS_TOKEN=
DISCOGS_USERNAME=

# Claude API key for the natural-language query feature
ANTHROPIC_API_KEY=

# Optional enrichment sources (set up later, in Phase 2)
LASTFM_API_KEY=

# Where the SQLite database file lives. Leave unset for local `npm run dev`
# (defaults to ./data/app.db). Do NOT set this for Docker/docker-compose —
# the image already sets DATABASE_PATH=/data/app.db to match the mounted
# volume; overriding it here via env_file would break that mount.
# DATABASE_PATH=./data/app.db
